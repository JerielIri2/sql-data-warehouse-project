--Checks NULLS or Duplicates for Primary Key
SELECT 
    cst_id,
    COUNT(*) AS total_rows
FROM bronze.crm_customer_info
GROUP BY cst_id
HAVING COUNT(*) > 1 OR cst_id IS NULL;

